# ----------------------------------------------------------------------------
# ImmoPro Entreprise — configuration d'exemple (AUCUN SECRET RÉEL ICI)
# Copiez ce fichier en « .env » (même dossier) et adaptez-le.
# Ne versionnez jamais le fichier .env.
# ----------------------------------------------------------------------------

# development | production
APP_ENV=development

# Clé secrète (64 caractères aléatoires minimum en production). Générer avec :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Base de données : SQLite en développement, PostgreSQL en production
DATABASE_URL=sqlite:///./data/immopro.db
# DATABASE_URL=postgresql+psycopg://immopro:MOT_DE_PASSE@127.0.0.1:5432/immopro

# Adresse publique (utilisée pour les liens de réinitialisation de mot de passe)
PUBLIC_BASE_URL=http://localhost:5173

# Cookies « Secure » : true OBLIGATOIRE en production (HTTPS). false uniquement en local http.
COOKIE_SECURE=false
# true si l'application est derrière un reverse proxy de confiance (Caddy/Nginx) qui fixe X-Forwarded-For
TRUST_PROXY_HEADERS=false

# Sessions
SESSION_IDLE_MINUTES=480
SESSION_MAX_HOURS=168
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
RESET_TOKEN_MINUTES=30

# Fichiers téléversés (hors de tout dossier public) et taille maximale
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=25

# Sauvegardes automatiques (0 = désactivées)
BACKUP_DIR=./data/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14

# Géocodage via la Géoplateforme IGN (service public, gratuit). false pour désactiver.
GEOCODER_ENABLED=true
GEOCODER_URL=https://data.geopf.fr/geocodage/search
