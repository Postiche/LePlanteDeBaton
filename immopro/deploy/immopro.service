# /etc/systemd/system/immopro.service — alternative sans Docker (Linux)
[Unit]
Description=ImmoPro Entreprise
After=network.target postgresql.service

[Service]
User=immopro
WorkingDirectory=/opt/immopro/backend
EnvironmentFile=/opt/immopro/backend/.env
ExecStartPre=/opt/immopro/backend/.venv/bin/python -m app.cli init-db
ExecStart=/opt/immopro/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --workers 1
Restart=always
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
